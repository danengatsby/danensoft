# Exemplu de configurare nginx pentru site-ul static și serviciul Node.
# Adaptați server_name și certificatele; apoi:
#   npm run build
#
# Antetele de securitate stau în două fișiere din /etc/nginx/snippets/:
#   danen-headers.conf — HSTS, X-Frame-Options, nosniff, Referrer-Policy
#   danen-csp.conf     — politica de conținut, doar pentru fișierele statice
#
# Atenție: un `location` care are propriul `add_header` nu mai moștenește
# antetele de mai sus, deci fișierele trebuie incluse din nou acolo.

server {
    listen 80;
    server_name danenachesoft.space www.danenachesoft.space;

    root /var/www/danen/current;
    index index.html;
    error_page 404 /404.html;

    include snippets/danen-headers.conf;
    include snippets/danen-csp.conf;

    # Serviciul de mesaje. CSP nu se include aici: paginile randate de Node își
    # trimit propria politică, iar două antete CSP s-ar aplica simultan.
    location /api/ {
        proxy_pass http://127.0.0.1:8091;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # Cheia limitării de rată. Trebuie setat din $remote_addr, nu preluat
        # de la client, altfel limitarea se ocolește printr-un antet fals.
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;

        include snippets/danen-headers.conf;
    }

    # Conturile sunt randate de Node. /cont are potrivire exactă pentru a nu
    # intercepta pagina publică /contact; /cont/ acoperă acțiunile contului.
    location = /cont {
        proxy_pass http://127.0.0.1:8091;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;

        include snippets/danen-headers.conf;
    }

    location /cont/ {
        proxy_pass http://127.0.0.1:8091;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;

        include snippets/danen-headers.conf;
    }

    # Administrare, export CSV și acțiuni asupra mesajelor, ca în configurația activă.
    location ^~ /admin {
        proxy_pass http://127.0.0.1:8091;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;

        include snippets/danen-headers.conf;
    }

    # Paginile valide au HTML prerandat; adresele inexistente păstrează statusul 404.
    location / {
        try_files $uri $uri/ =404;
    }

    # Redirecționare internă: URL-ul cerut și statusul 404 rămân în răspuns.
    location = /404.html {
        internal;
        add_header Cache-Control "no-store" always;

        include snippets/danen-headers.conf;
        include snippets/danen-csp.conf;
    }

    # Fișierele din assets/ au hash în nume, deci pot fi memorate agresiv.
    location /assets/ {
        alias /var/www/danen/shared-assets/;
        expires 1y;
        add_header Cache-Control "public, immutable";
        access_log off;

        include snippets/danen-headers.conf;
        include snippets/danen-csp.conf;
    }

    # index.html nu se memorează, ca lansările noi să ajungă imediat la vizitatori.
    location = /index.html {
        add_header Cache-Control "no-cache";

        include snippets/danen-headers.conf;
        include snippets/danen-csp.conf;
    }

    gzip on;
    gzip_types text/css application/javascript image/svg+xml;
    gzip_min_length 1024;
}
